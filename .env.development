# Development environment optimizations
# These settings speed up Next.js compilation and hot reload

# Skip type checking in dev (run separately with `tsc --noEmit`)
NEXT_SKIP_TYPE_CHECK=true

# Disable telemetry for faster startup
NEXT_TELEMETRY_DISABLED=1

# Faster source maps (less accurate but much faster)
NEXT_DEV_SOURCEMAP=eval-cheap-source-map
